# Shared persistence (GitHub Contents API).
# When set, every deploy shares the same tier list / history / prizes.
# Create a fine-grained PAT with Contents: Read and write on this repo.
GITHUB_TOKEN=
GITHUB_REPO=NoshadBoksh/LeagueTeamPicker
GITHUB_STATE_PATH=data/app-state.json
# Dedicated branch so saves don't redeploy the website from main.
GITHUB_STATE_BRANCH=app-data

# Without GITHUB_TOKEN, the API falls back to a local data/app-state.json file
# (fine for single-machine `next start`, not shared across hosts).
